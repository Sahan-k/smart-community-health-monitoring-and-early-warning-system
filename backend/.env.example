# HealthGuard AI — Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to version control.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/community_health_db

# ── Risk Report Window ────────────────────────────────────────────────────────
# Rolling time window (in hours) for active disease risk calculations.
# Reports older than this window are excluded from risk levels and alerts.
# Historical data, charts, and report history are NOT affected by this setting.
#
# 24  → 24-hour window (testing mode)
# 168 → 7-day window   (production mode — change here, then restart backend)
RISK_REPORT_WINDOW_HOURS=24

# ── Email / SMTP Configuration ───────────────────────────────────────────────
# Sender Gmail address for HIGH RISK health alert emails
SMTP_EMAIL=healthguardai.alerts@gmail.com
# Gmail App Password (16-character, generated from Google Account → Security → App Passwords)
# NEVER use your regular Gmail login password here.
SMTP_PASSWORD=qrwmfggeucrkitic
# SMTP server (leave as smtp.gmail.com for Gmail)
SMTP_SERVER=smtp.gmail.com
# SMTP port (587 = STARTTLS; 465 = SSL — 587 recommended)
SMTP_PORT=587

# ── Firebase Cloud Messaging (optional) ──────────────────────────────────────
# Set either FIREBASE_CREDENTIALS_JSON (inline JSON string) or FIREBASE_CREDENTIALS_PATH (file path)
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# SECRET_KEY=your-jwt-secret-key-here
